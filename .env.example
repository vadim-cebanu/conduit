# Copy this file to .env and set your own values.
# .env is ignored by git - never commit real secrets.

# Frontend port on the host
FRONTEND_PORT=8282

# PostgreSQL (used by the database and the backend)
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=change-me

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=backend,localhost
