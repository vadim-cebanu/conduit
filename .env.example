# Copy this file to .env and set your own values.
# .env is ignored by git - never commit real secrets.

# ---------- Secrets (change them!) ----------
POSTGRES_USER=conduit
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# ---------- Configuration ----------
# Frontend port on the host
FRONTEND_PORT=8282

# Database name
POSTGRES_DB=conduit

# Django
DEBUG=False
ALLOWED_HOSTS=backend,localhost

# Gunicorn worker processes
GUNICORN_WORKERS=3

# ---------- Versions ----------
# Version tag of the own images (conduit-backend, conduit-frontend)
APP_VERSION=latest

# Base image versions
POSTGRES_VERSION=16.10
PYTHON_VERSION=3.6
NODE_VERSION=20.18
NGINX_VERSION=1.27